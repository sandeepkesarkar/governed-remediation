# Names only. Copy to .env and fill in locally. Never commit .env.
ANTHROPIC_API_KEY=
# The ticket step's token: Issues read and write. The fix step also uses it to read one issue.
GITHUB_TOKEN=
# The fix step's publish token, a different token: fine-grained, this repository only,
# Contents read and write, Pull requests read and write, 30-day expiry. Only the publish script sees it.
# It never goes into the OpenHands sandbox or the client container.
GITHUB_FIX_TOKEN=
# The verify step's token, a third one: fine-grained, this repository only,
# Issues read and write, Pull requests read and write, 30-day expiry. No Contents.
# It posts the evidence comment on the pull request and the short summary on the issue.
GITHUB_VERIFY_TOKEN=
